{
  "name": "@hyperbitjs/hdkey",
  "version": "1.0.0",
  "type": "module",
  "description": "Bitcoin BIP32 hierarchical deterministic keys",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperbit-dev/hdkey.git"
  },
  "license": "MIT",
  "keywords": [
    "bitcoin",
    "bip32",
    "bip",
    "key",
    "hierarchical",
    "deterministic",
    "crypto"
  ],
  "bugs": {
    "url": "https://github.com/hyperbit-dev/hdkey/issues"
  },
  "homepage": "https://github.com/hyperbit-dev/hdkey",
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "@scure/base": "^1.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.56.0",
    "prettier": "^3.0.3",
    "secure-random": "^1.1.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "validate": "npm run type-check && npm run lint && npm run test",
    "prepublishOnly": "npm run build && npm run validate"
  },
  "publishConfig": {
    "access": "public"
  }
}
